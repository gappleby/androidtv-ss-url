<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AndroidTvSS" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent_dark</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:colorControlNormal">@color/input_border</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Used by TestUrlActivity — pure black, nothing but the WebView -->
    <style name="Theme.AndroidTvSS.Fullscreen" parent="Theme.AndroidTvSS">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>
