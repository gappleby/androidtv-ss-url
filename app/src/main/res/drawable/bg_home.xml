<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen backdrop: deep diagonal gradient with a soft accent glow behind the title -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/surface"
                android:endColor="@color/background"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.3"
                android:gradientRadius="700"
                android:startColor="@color/home_glow"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
